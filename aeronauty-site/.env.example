# Aeronauty lab magic-link gate.
# Keep real values in Vercel Environment Variables or .env.local.

# Reuse AUTH_SECRET if already configured, or set a separate lab secret.
AERONAUTY_AUTH_SECRET=

# Comma-separated allowlist. Only these emails receive lab sign-in links.
# Supports exact addresses and wildcard domains like *@example.com.
AERONAUTY_LAB_ALLOWED_EMAILS=

# Resend is used to send production magic-link emails.
RESEND_API_KEY=
AERONAUTY_MAGIC_LINK_FROM="Aeronauty <lab@aeronauty.com>"

# Optional but recommended: enables three-click magic links for corporate link scanners.
# Also stores first-party activity events for the private lab activity view.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical host for generated magic links.
NEXT_PUBLIC_SITE_URL=https://aeronauty.com
AUTH_URL=https://aeronauty.com
NEXTAUTH_URL=https://aeronauty.com

# Google OAuth for lab SSO and dashboard integrations.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Slop screenshot storage (dedicated Supabase project "slop_basket").
# Use the new-format secret key (sb_secret_...). It is server-only — never expose it client-side.
# (Legacy service_role JWT also works via SUPABASE_SERVICE_ROLE_KEY.)
# Without these, /slop submissions still work but skip the screenshot upload.
SUPABASE_URL=https://dykpznfwxapfgnbbooto.supabase.co
SUPABASE_SECRET_KEY=
