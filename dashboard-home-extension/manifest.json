{
  "manifest_version": 3,
  "name": "Dashboard Home Button",
  "version": "1.0",
  "description": "Floating home button to return to the kitchen dashboard",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
